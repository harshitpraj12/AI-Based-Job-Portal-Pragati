# ==============================================================================
# Environment Configuration for AI-Based Job Portal Docker Environment
# ==============================================================================

# Spring Boot Server Port
SERVER_PORT=8080

# MySQL Configuration (Relational Database)
MYSQL_PORT=3306
MYSQL_DATABASE=jobportal
MYSQL_ROOT_PASSWORD=Harshit@1

# MariaDB Vector Store Configuration
MARIADB_PORT=3307
MARIADB_DATABASE=vectordb
MARIADB_ROOT_PASSWORD=root123

# Ollama AI Configuration
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# JWT Authentication Secret (Minimum 32 characters)
JWT_SECRET=your-super-secret-key-that-is-at-least-32-character-long
JWT_EXPIRATION=86400000
